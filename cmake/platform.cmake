# Platform files contain data only; build rules live with the SDK framework.
set(_platform_root "${HIFW_PLATFORM_PATH}")
set(HIFW_PLATFORM_INCLUDE_DIRS "")
set(HIFW_PLATFORM_LIB_DIRS "")
foreach(_group IN ITEMS common mpp isp svp)
    list(APPEND HIFW_PLATFORM_INCLUDE_DIRS "${_platform_root}/hisilicon/${_group}/include")
    list(APPEND HIFW_PLATFORM_LIB_DIRS "${_platform_root}/hisilicon/${_group}/lib")
    if(NOT TARGET platform::${_group})
        add_library(platform::${_group} INTERFACE IMPORTED GLOBAL)
    endif()
endforeach()

function(hifw_platform_library name output)
    foreach(_dir IN LISTS HIFW_PLATFORM_LIB_DIRS)
        if(EXISTS "${_dir}/${name}")
            set(${output} "${_dir}/${name}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Platform library not found: ${name}")
endfunction()

foreach(_group IN ITEMS common mpp isp svp)
    set_property(TARGET platform::${_group} PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${HIFW_PLATFORM_INCLUDE_DIRS}")
endforeach()
set_property(TARGET platform::common PROPERTY INTERFACE_COMPILE_DEFINITIONS
    "hi3516cv610;OT_XXXX;ISP_V2;USER_BIT_32;KERNEL_BIT_32;OT_RELEASE")
set(_common ss_mpi ss_mpi_sysbind ss_mpi_sysmem ot_sys ot_vb ot_pm ot_vca ot_irq ot_chnl ot_base ot_osal securec)
set(_mpp ot_vi ot_vpss ot_vgs ot_vpp ot_venc ot_rc ot_h264e ot_h265e ot_svac3e ot_jpege ot_rgn)
set(_isp ss_mpi_ae ss_mpi_isp ot_mpi_isp ss_mpi_awb dehaze extend_stats drc ldci bnr calcflicker ir_auto acs ot_sensor_i2c ot_isp)
set(_svp svp_acl protobuf-c)
foreach(_group IN ITEMS common mpp isp svp)
    set(_libraries "")
    foreach(_name IN LISTS _${_group})
        hifw_platform_library("lib${_name}.so" _path)
        list(APPEND _libraries "${_path}")
    endforeach()
    set_property(TARGET platform::${_group} PROPERTY INTERFACE_LINK_LIBRARIES "${_libraries}")
endforeach()
set_property(TARGET platform::common APPEND PROPERTY INTERFACE_LINK_LIBRARIES pthread m dl)
set_property(TARGET platform::mpp APPEND PROPERTY INTERFACE_LINK_LIBRARIES platform::common)
set_property(TARGET platform::isp APPEND PROPERTY INTERFACE_LINK_LIBRARIES platform::mpp stdc++)
set_property(TARGET platform::svp APPEND PROPERTY INTERFACE_LINK_LIBRARIES platform::common)

# Legacy upstream sources require soc/include and soc/libs/musl. Materialize
# ordinary build files once; no symlink or per-user toolchain view is involved.
set(HIFW_VENDOR_COMPAT_ROOT "${CMAKE_BINARY_DIR}/hifw/vendor-sdk")
set(HIFW_SDK_INCLUDE_DIR "${HIFW_VENDOR_COMPAT_ROOT}/soc/include")
set(HIFW_SDK_LIB_DIR "${HIFW_VENDOR_COMPAT_ROOT}/soc/libs/musl")
set(HIFW_SDK_CONFIG_DIR "${HIFW_SDK_INCLUDE_DIR}")
set(HIFW_SDK_SENSOR_COMMON_DIR "${HIFW_SDK_INCLUDE_DIR}/sensor_common")
file(GLOB_RECURSE _platform_inputs CONFIGURE_DEPENDS "${_platform_root}/hisilicon/*")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_platform_root}/manifest.json" ${_platform_inputs})
file(SHA256 "${_platform_root}/manifest.json" _platform_hash)
foreach(_input IN LISTS _platform_inputs)
    file(SHA256 "${_input}" _input_hash)
    string(APPEND _platform_hash "${_input_hash}")
endforeach()
string(SHA256 _platform_hash "${_platform_hash}")
if(NOT EXISTS "${HIFW_VENDOR_COMPAT_ROOT}/.${_platform_hash}")
    file(REMOVE_RECURSE "${HIFW_VENDOR_COMPAT_ROOT}")
    file(MAKE_DIRECTORY "${HIFW_SDK_INCLUDE_DIR}" "${HIFW_SDK_LIB_DIR}"
        "${HIFW_VENDOR_COMPAT_ROOT}/soc/config/gcc")
    foreach(_dir IN LISTS HIFW_PLATFORM_INCLUDE_DIRS)
        file(COPY "${_dir}/" DESTINATION "${HIFW_SDK_INCLUDE_DIR}")
    endforeach()
    foreach(_dir IN LISTS HIFW_PLATFORM_LIB_DIRS)
        file(COPY "${_dir}/" DESTINATION "${HIFW_SDK_LIB_DIR}")
    endforeach()
    file(COPY "${HIFW_SDK_INCLUDE_DIR}/autoconf.h"
        DESTINATION "${HIFW_VENDOR_COMPAT_ROOT}/soc/config/gcc")
    file(WRITE "${HIFW_VENDOR_COMPAT_ROOT}/.${_platform_hash}" "")
endif()

# Target system packages retain their own include/lib layout and relocatable .pc
# files. Only exported target metadata is searched; host libraries are excluded.
file(GLOB _system_packages LIST_DIRECTORIES true "${_platform_root}/packages/*")
set(_pkg_dirs "")
set(_system_roots "")
foreach(_package IN LISTS _system_packages)
    list(APPEND _system_roots "${_package}")
    foreach(_subdir IN ITEMS usr/lib/pkgconfig usr/share/pkgconfig lib/pkgconfig share/pkgconfig)
        if(IS_DIRECTORY "${_package}/${_subdir}")
            list(APPEND _pkg_dirs "${_package}/${_subdir}")
        endif()
    endforeach()
endforeach()
# Resolve shared-library transitive dependencies at link time without embedding
# SDK directories into the runtime search path of the board executable.
foreach(_root IN LISTS _system_roots)
    foreach(_subdir IN ITEMS usr/lib lib)
        if(IS_DIRECTORY "${_root}/${_subdir}")
            add_link_options("LINKER:-rpath-link,${_root}/${_subdir}")
        endif()
    endforeach()
endforeach()
foreach(_dir IN LISTS HIFW_PLATFORM_LIB_DIRS)
    add_link_options("LINKER:-rpath-link,${_dir}")
endforeach()
list(APPEND CMAKE_FIND_ROOT_PATH ${_system_roots})
list(JOIN _pkg_dirs ":" _pkg_libdir)
set(ENV{PKG_CONFIG_LIBDIR} "${_pkg_libdir}")
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "")
find_program(_hifw_pkgconfig NAMES pkgconf pkg-config NO_CMAKE_FIND_ROOT_PATH)
if(_hifw_pkgconfig)
    set(PKG_CONFIG_EXECUTABLE "${_hifw_pkgconfig}" CACHE FILEPATH "Host pkg-config for exported target packages" FORCE)
endif()
set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH FALSE)

# Parse pkg-config flags with shell quoting explicitly. Older FindPkgConfig
# versions split escaped spaces in relocated SDK paths incorrectly.
function(hifw_import_system_package module target)
    execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --cflags "${module}"
        OUTPUT_VARIABLE _cflags RESULT_VARIABLE _result ERROR_VARIABLE _error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_result)
        message(FATAL_ERROR "Platform package '${module}' unavailable: ${_error}")
    endif()
    execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --libs "${module}"
        OUTPUT_VARIABLE _ldflags RESULT_VARIABLE _result ERROR_VARIABLE _error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_result)
        message(FATAL_ERROR "Platform package '${module}' unavailable: ${_error}")
    endif()
    separate_arguments(_cflags UNIX_COMMAND "${_cflags}")
    separate_arguments(_ldflags UNIX_COMMAND "${_ldflags}")
    add_library("${target}" INTERFACE IMPORTED GLOBAL)
    set(_includes "")
    set(_options "")
    foreach(_flag IN LISTS _cflags)
        if(_flag MATCHES "^-I(.+)")
            list(APPEND _includes "${CMAKE_MATCH_1}")
        else()
            list(APPEND _options "${_flag}")
        endif()
    endforeach()
    set(_dirs "")
    set(_libraries "")
    set(_link_options "")
    foreach(_flag IN LISTS _ldflags)
        if(_flag MATCHES "^-L(.+)")
            list(APPEND _dirs "${CMAKE_MATCH_1}")
        elseif(_flag MATCHES "^-l(.+)")
            list(APPEND _libraries "${_flag}")
        elseif(IS_ABSOLUTE "${_flag}")
            list(APPEND _libraries "${_flag}")
        else()
            list(APPEND _link_options "${_flag}")
        endif()
    endforeach()
    set_target_properties("${target}" PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_includes}"
        INTERFACE_COMPILE_OPTIONS "${_options}"
        INTERFACE_LINK_DIRECTORIES "${_dirs}"
        INTERFACE_LINK_LIBRARIES "${_libraries}"
        INTERFACE_LINK_OPTIONS "${_link_options}")
endfunction()
