set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
if(NOT CROSS_PREFIX)
    if(DEFINED ENV{CROSS_PREFIX})
        set(CROSS_PREFIX "$ENV{CROSS_PREFIX}")
    else()
        set(CROSS_PREFIX "arm-v01c02-linux-musleabi-")
    endif()
endif()
set(CROSS_PREFIX "${CROSS_PREFIX}" CACHE STRING "Cross compiler prefix")
foreach(_pair IN ITEMS "C;gcc" "CXX;g++" "ASM;gcc")
    list(GET _pair 0 _language)
    list(GET _pair 1 _tool)
    find_program(_compiler_${_language} NAMES "${CROSS_PREFIX}${_tool}" REQUIRED)
    set(CMAKE_${_language}_COMPILER "${_compiler_${_language}}" CACHE FILEPATH "" FORCE)
endforeach()
foreach(_tool IN ITEMS ar ranlib strip)
    string(TOUPPER "${_tool}" _upper)
    find_program(_tool_${_tool} NAMES "${CROSS_PREFIX}${_tool}" REQUIRED)
    set(CMAKE_${_upper} "${_tool_${_tool}}" CACHE FILEPATH "" FORCE)
endforeach()
set(HIFW_ARM_ABI_FLAGS "-mcpu=cortex-a7 -mfloat-abi=softfp -mfpu=neon-vfpv4")
set(CMAKE_C_FLAGS_INIT "${HIFW_ARM_ABI_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${HIFW_ARM_ABI_FLAGS}")
set(CMAKE_ASM_FLAGS_INIT "${HIFW_ARM_ABI_FLAGS}")
separate_arguments(_abi_flags NATIVE_COMMAND "${HIFW_ARM_ABI_FLAGS}")
execute_process(COMMAND "${CMAKE_C_COMPILER}" ${_abi_flags} -print-sysroot
    OUTPUT_VARIABLE _sysroot OUTPUT_STRIP_TRAILING_WHITESPACE)
# Do not override the compiler's multilib selection with CMAKE_SYSROOT.
set(CMAKE_FIND_ROOT_PATH "${_sysroot}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CROSS_PREFIX)
